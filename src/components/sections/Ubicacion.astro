---
const APP_URL = 'https://frontend-oktava-frontend-web.b5lsqc.easypanel.host/';
---

<section id="ubicacion" class="py-20 md:py-28 bg-dark-100">
  <div class="mx-auto max-w-6xl px-4 md:px-6 space-y-10">

    <!-- Header -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-brand mb-2 font-secondary">Encuéntranos</p>
      <h2 class="text-5xl md:text-6xl font-display uppercase text-white leading-none">
        Nuestra Ubicación
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-start">

      <!-- Info column -->
      <div class="space-y-4">

        <!-- Address -->
        <div class="oktava-surface rounded-2xl p-5 flex gap-4 items-start">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-500/10 border border-red-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <div>
            <h3 class="text-base font-bold text-white mb-1 font-secondary">Dirección</h3>
            <p class="text-sm text-zinc-400 leading-relaxed font-secondary">
              Av. Ejemplo 123, Piso 2<br />
              Ciudad, País
            </p>
          </div>
        </div>

        <!-- Hours -->
        <div class="oktava-surface rounded-2xl p-5 flex gap-4 items-start">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-yellow-500/10 border border-yellow-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-400" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </span>
          <div class="flex-1">
            <h3 class="text-base font-bold text-white mb-2 font-secondary">Horarios</h3>
            <div class="space-y-1.5 text-sm text-zinc-400 font-secondary">
              <div class="flex justify-between gap-8">
                <span>Lunes – Viernes</span>
                <span class="text-white font-semibold">11:00 – 22:00</span>
              </div>
              <div class="flex justify-between gap-8">
                <span>Sábado – Domingo</span>
                <span class="text-white font-semibold">10:00 – 23:00</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact / CTA -->
        <div class="oktava-surface rounded-2xl p-5 flex gap-4 items-start">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-green-500/10 border border-green-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.9-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <div>
            <h3 class="text-base font-bold text-white mb-1 font-secondary">Pedidos y consultas</h3>
            <p class="text-sm text-zinc-400 font-secondary mb-3">Pide directamente desde la app o comunícate con nosotros.</p>
            <a
              href={APP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-2.5 text-sm font-bold text-white hover:bg-red-500 transition-colors"
            >
              Pedir online →
            </a>
          </div>
        </div>

      </div>

      <!-- Map placeholder -->
      <div class="relative rounded-2xl overflow-hidden bg-zinc-900 aspect-[4/3] border border-white/8">
        <div class="absolute inset-0 oktava-grid-bg opacity-15 pointer-events-none"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 select-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-700" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p class="text-sm font-secondary text-zinc-600">Mapa próximamente</p>
        </div>
        <!--
          Cuando tengas la dirección exacta, reemplaza este div con:
          <iframe
            src="https://maps.google.com/maps?q=TU+DIRECCION&output=embed"
            width="100%" height="100%"
            class="absolute inset-0 w-full h-full border-0"
            loading="lazy"
            allowfullscreen
          ></iframe>
        -->
      </div>

    </div>
  </div>
</section>
