---
const APP_URL = 'https://pedido.oktava8.com';

const pillars = [
  {
    emoji: '⚡',
    bgClass: 'bg-yellow-500/10',
    borderClass: 'border-yellow-500/20',
    accentClass: 'text-yellow-400',
    title: 'Entrega Rápida',
    desc: 'Flujo optimizado para que tu pedido llegue en minutos. Sin esperas, sin excusas.',
  },
  {
    emoji: '🔥',
    bgClass: 'bg-red-500/10',
    borderClass: 'border-red-500/20',
    accentClass: 'text-brand',
    title: 'Sabor Premium',
    desc: 'Ingredientes frescos, recetas auténticas y estándares claros en cada plato que preparamos.',
  },
  {
    emoji: '✓',
    bgClass: 'bg-green-500/10',
    borderClass: 'border-green-500/20',
    accentClass: 'text-green-400',
    title: 'Siempre Fresco',
    desc: 'Todo preparado al momento. Lo que pides se hace nuevo, sin reutilizados ni atajos.',
  },
];
---

<section id="por-que" class="py-20 md:py-28 bg-dark-100">
  <div class="relative mx-auto max-w-6xl px-4 md:px-6">

    <!-- Background glow -->
    <div class="absolute left-1/2 -translate-x-1/2 -top-20 h-96 w-96 rounded-full bg-brand/8 blur-[140px] pointer-events-none"></div>

    <div class="relative space-y-10">

      <!-- Header -->
      <div data-animate="fade-up">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand mb-2 font-secondary">Por qué elegirnos</p>
        <h2 class="text-5xl md:text-6xl font-display uppercase text-white leading-none">
          Oktava en 3 palabras
        </h2>
      </div>

      <!-- 3-card grid -->
      <div class="grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <article class="oktava-surface rounded-2xl p-6 flex flex-col gap-4" data-animate="fade-up" data-delay={String((i + 1) * 100)}>
            <span class:list={['inline-flex h-12 w-12 items-center justify-center rounded-xl text-2xl border', p.bgClass, p.borderClass]}>
              {p.emoji}
            </span>
            <div class="space-y-2">
              <h3 class="text-xl font-bold text-white font-secondary">{p.title}</h3>
              <p class="text-sm leading-relaxed text-zinc-400 font-secondary">{p.desc}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- CTA banner -->
      <div class="relative overflow-hidden rounded-2xl bg-dark-200 border border-white/8 p-8 md:p-10 flex flex-col md:flex-row items-center gap-6" data-animate="fade-up" data-delay="100">
        <div class="absolute inset-0 oktava-grid-bg opacity-30 pointer-events-none"></div>
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-64 w-64 rounded-full bg-brand/10 blur-[80px] pointer-events-none"></div>
        <div class="relative flex-1">
          <h3 class="text-3xl md:text-4xl font-display uppercase text-white">¿Listo para pedir?</h3>
          <p class="text-sm text-zinc-400 mt-1 font-secondary">Explora el menú completo y arma tu pedido perfecto.</p>
        </div>
        <a
          href={APP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="relative shrink-0 inline-flex items-center gap-2 rounded-2xl bg-brand px-8 py-4 text-sm font-bold text-white shadow-xl shadow-red-900/40 hover:bg-red-500 hover:scale-105 transition-all"
        >
          Hacer Pedido
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>
</section>
