---
const tiles = [
  { aspect: 'aspect-[3/4]',  bg: 'bg-zinc-800' },
  { aspect: 'aspect-square', bg: 'bg-zinc-900' },
  { aspect: 'aspect-[4/3]',  bg: 'bg-zinc-800' },
  { aspect: 'aspect-[3/4]',  bg: 'bg-zinc-900' },
  { aspect: 'aspect-square', bg: 'bg-zinc-800' },
  { aspect: 'aspect-[3/4]',  bg: 'bg-zinc-900' },
  { aspect: 'aspect-[4/3]',  bg: 'bg-zinc-800' },
  { aspect: 'aspect-square', bg: 'bg-zinc-900' },
  { aspect: 'aspect-[3/4]',  bg: 'bg-zinc-800' },
];
---

<section id="galeria" class="py-20 md:py-28 bg-dark-100">
  <div class="mx-auto max-w-6xl px-4 md:px-6 space-y-10">

    <!-- Header -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-brand mb-2 font-secondary">Galería</p>
      <h2 class="text-5xl md:text-6xl font-display uppercase text-white leading-none">
        Nuestros Platos
      </h2>
    </div>

    <!-- CSS masonry via columns -->
    <div class="columns-2 md:columns-3 gap-4">
      {tiles.map(tile => (
        <div class:list={['break-inside-avoid mb-4 rounded-xl overflow-hidden relative group cursor-pointer hover:opacity-90 transition-opacity', tile.aspect, tile.bg]}>
          <div class="absolute inset-0 bg-brand/5 group-hover:bg-brand/10 transition-colors pointer-events-none"></div>
          <div class="absolute inset-0 oktava-grid-bg opacity-10 pointer-events-none"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-700" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Instagram CTA -->
    <div class="text-center">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-6 py-2.5 text-sm text-zinc-400 hover:text-white hover:border-white/20 transition-all font-secondary"
      >
        <!-- Instagram icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
        </svg>
        Seguinos en Instagram
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>
