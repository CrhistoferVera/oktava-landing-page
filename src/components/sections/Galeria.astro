---
import { Image } from 'astro:assets';
import comida1 from '../../assets/comida1.jpg';
import comida2 from '../../assets/comida2.jpg';
import comida3 from '../../assets/comida3.jpg';
import comida4 from '../../assets/comida4.jpg';
import comida5 from '../../assets/comida5.jpg';
import comida6 from '../../assets/comida6.jpg';
import comida7 from '../../assets/comida7.jpg';
---

<section id="galeria" class="py-20 md:py-28 bg-dark-100">
  <div class="mx-auto max-w-6xl px-4 md:px-6 space-y-10">

    <!-- Header -->
    <div data-animate="fade-up">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand mb-2 font-secondary">Galería</p>
      <h2 class="text-5xl md:text-6xl font-display uppercase text-white leading-none">
        Nuestros Platos
      </h2>
    </div>

    <!--
      Layout:
      [ comida1 — 2 cols, 2 filas ] [ comida2 ]
      [                            ] [ comida7 ]
      [ comida3 ] [ comida4 ] [ comida5 ]
      [ comida6 — ancho completo   ]
    -->
    <div class="grid grid-cols-3 gap-3">

      <!-- comida1: 2 cols, 2 filas -->
      <div class="col-span-2 row-span-2 rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-left">
        <Image
          src={comida1}
          alt="Plato Oktava"
          width={1000}
          format="webp"
          quality={80}
          class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent pointer-events-none"></div>
      </div>

      <!-- comida2 -->
      <div class="aspect-video rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-right" data-delay="100">
        <Image
          src={comida2}
          alt="Plato Oktava"
          width={500}
          format="webp"
          quality={80}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent pointer-events-none"></div>
      </div>

      <!-- comida7: debajo de comida2 -->
      <div class="aspect-video rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-right" data-delay="200">
        <Image
          src={comida7}
          alt="Plato Oktava"
          width={500}
          format="webp"
          quality={80}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent pointer-events-none"></div>
      </div>

      <!-- comida3 -->
      <div class="aspect-video rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-up" data-delay="100">
        <Image
          src={comida3}
          alt="Plato Oktava"
          width={500}
          format="webp"
          quality={80}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent pointer-events-none"></div>
      </div>

      <!-- comida4 -->
      <div class="aspect-video rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-up" data-delay="200">
        <Image
          src={comida4}
          alt="Plato Oktava"
          width={500}
          format="webp"
          quality={80}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent pointer-events-none"></div>
      </div>

      <!-- comida5 -->
      <div class="aspect-video rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-up" data-delay="300">
        <Image
          src={comida5}
          alt="Plato Oktava"
          width={500}
          format="webp"
          quality={80}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent pointer-events-none"></div>
      </div>

      <!-- comida6: ancho completo -->
      <div class="col-span-3 aspect-video rounded-2xl overflow-hidden bg-zinc-800 relative group" data-animate="fade-up" data-delay="100">
        <Image
          src={comida6}
          alt="Plato Oktava"
          width={1200}
          format="webp"
          quality={80}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent pointer-events-none"></div>
      </div>

    </div>

    <!-- Instagram CTA -->
    <div class="text-center">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-6 py-2.5 text-sm text-zinc-400 hover:text-white hover:border-white/20 transition-all font-secondary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
        </svg>
        Seguinos en Instagram
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>
