---
const APP_URL = 'https://frontend-oktava-frontend-web.b5lsqc.easypanel.host/';

const categories = [
  { label: 'Hamburguesas', bg: 'bg-zinc-800' },
  { label: 'Combos',       bg: 'bg-zinc-900' },
  { label: 'Bebidas',      bg: 'bg-zinc-800' },
  { label: 'Extras',       bg: 'bg-zinc-900' },
];
---

<section id="menu" class="py-20 md:py-28 bg-dark-300">
  <div class="mx-auto max-w-6xl px-4 md:px-6 space-y-10">

    <!-- Header -->
    <div class="flex items-end justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand mb-2 font-secondary">Explora</p>
        <h2 class="text-5xl md:text-6xl font-display uppercase text-white leading-none">
          Nuestro Menú
        </h2>
      </div>
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1.5 text-sm text-zinc-400 hover:text-white transition-colors font-secondary"
      >
        Ver menú completo
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Category grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {categories.map(cat => (
        <div class:list={['group relative aspect-square rounded-2xl overflow-hidden cursor-pointer hover:-translate-y-1 hover:shadow-xl hover:shadow-black/50 transition-all border border-white/8', cat.bg]}>
          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
          <!-- Red tint on hover -->
          <div class="absolute inset-0 bg-brand/5 group-hover:bg-brand/12 transition-colors"></div>
          <!-- Grid texture -->
          <div class="absolute inset-0 oktava-grid-bg opacity-15"></div>
          <!-- Placeholder icon -->
          <div class="absolute inset-0 flex items-center justify-center opacity-20">
            <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-300" aria-hidden="true">
              <path d="M3 11l19-9-9 19-2-8-8-2z"/>
            </svg>
          </div>
          <!-- Label -->
          <p class="absolute bottom-0 left-0 right-0 px-4 pb-4 font-bold text-white text-lg font-secondary uppercase tracking-wide drop-shadow-md">
            {cat.label}
          </p>
        </div>
      ))}
    </div>

    <!-- Promo strip -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-red-950 to-red-900/80 border border-red-700/30 p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center gap-4 justify-between">
      <div class="absolute right-0 top-0 h-48 w-48 rounded-full bg-red-500/15 blur-[60px] pointer-events-none"></div>
      <div class="absolute inset-0 oktava-grid-bg opacity-10 pointer-events-none"></div>
      <div class="relative">
        <p class="text-xs font-semibold uppercase tracking-widest text-red-300 mb-1 font-secondary">Oferta limitada</p>
        <h3 class="text-2xl md:text-3xl font-display uppercase text-white">Combo Fuego — solo Bs. 129</h3>
        <p class="text-sm text-red-200/70 mt-1 font-secondary">Combo completo + 2 bebidas. Disponible hoy.</p>
      </div>
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="relative shrink-0 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-red-700 hover:bg-zinc-100 hover:scale-105 transition-all"
      >
        Pedir ahora →
      </a>
    </div>

    <!-- Mobile ver menú link -->
    <div class="md:hidden text-center">
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm text-zinc-400 hover:text-white transition-colors font-secondary"
      >
        Ver menú completo →
      </a>
    </div>

  </div>
</section>
