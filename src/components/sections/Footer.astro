---
const APP_URL = 'https://frontend-oktava-frontend-web.b5lsqc.easypanel.host/';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/8 bg-black py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4 md:px-6">

    <!-- Top grid -->
    <div class="grid md:grid-cols-3 gap-10 pb-10 border-b border-white/8">

      <!-- Logo + tagline -->
      <div class="space-y-4">
        <a href="#inicio">
          <img src="/logo_2.png" alt="Oktava" class="h-44 w-auto pl-10" />
        </a>
      </div>

      <!-- Nav links -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-4 font-secondary">Navegar</h4>
        <ul class="space-y-2.5 text-sm text-zinc-400 font-secondary">
          <li><a href="#nosotros" class="hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="#menu" class="hover:text-white transition-colors">Menú</a></li>
          <li><a href="#galeria" class="hover:text-white transition-colors">Galería</a></li>
          <li><a href="#ubicacion" class="hover:text-white transition-colors">Ubicación</a></li>
          <li>
            <a
              href={APP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand hover:text-red-400 transition-colors font-semibold"
            >
              Hacer Pedido →
            </a>
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-4 font-secondary">Síguenos</h4>
        <div class="flex gap-3">

          <!-- Instagram -->
          <a href="#" aria-label="Instagram" class="inline-flex items-center justify-center h-10 w-10 rounded-lg border border-white/10 bg-white/5 text-zinc-400 hover:text-white hover:border-white/20 hover:bg-white/10 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a href="#" aria-label="TikTok" class="inline-flex items-center justify-center h-10 w-10 rounded-lg border border-white/10 bg-white/5 text-zinc-400 hover:text-white hover:border-white/20 hover:bg-white/10 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a href="#" aria-label="WhatsApp" class="inline-flex items-center justify-center h-10 w-10 rounded-lg border border-white/10 bg-white/5 text-zinc-400 hover:text-green-400 hover:border-green-500/30 hover:bg-green-500/10 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
          </a>

        </div>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-zinc-600 font-secondary">
      <p>© {year} Oktava. Todos los derechos reservados.</p>
      <p class="text-zinc-700">Diseñado para los amantes del buen sabor.</p>
    </div>

  </div>
</footer>
